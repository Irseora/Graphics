{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "C/C++: g++ build active file",
      "command": "/usr/bin/g++ -fdiagnostics-color=always -std=c++20 -g -DGLM_ENABLE_EXPERIMENTAL $(find . -name '*.cpp') -o '${fileBasenameNoExtension}.out' -I. -I./includes -I${env:HOME}/vcpkg/installed/x64-linux/include -I${env:HOME}/vcpkg/installed/x64-linux/include/imgui -L${env:HOME}/vcpkg/installed/x64-linux/lib -limgui -lSDL3 -lSDL3_image -lGLEW -lGL",
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Dynamic compiler task for all subprojects"
    }
  ]
}